PORT=3000
DB_PATH=./data/wisuda.db
# Login admin (akses penuh). WAJIB diisi, tanpa ini tidak ada yang bisa login.
ADMIN_PASSWORD=
# Login operator scanner (hanya pilih event, scan, lihat daftar). Kosong = nonaktif.
SCANNER_PASSWORD=
# Password tambahan untuk tombol "Reset Presensi" (khusus admin). Kosong = fitur reset nonaktif.
RESET_PASSWORD=
# Di VPS di belakang nginx (HTTPS) isi 1. Biarkan kosong saat development.
TRUST_PROXY=
# Di VPS isi 127.0.0.1 agar port 3000 tidak terbuka langsung ke internet.
HOST=
# Opsional. Kosong = dibuat otomatis di server/data/session-secret
SESSION_SECRET=